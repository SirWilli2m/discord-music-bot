# Discord Bot Token (required)
# Get yours at https://discord.com/developers/applications
DISCORD_TOKEN=your-discord-bot-token-here

# Spotify API Credentials (optional — needed for Spotify link support)
# Get yours at https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your-spotify-client-id-here
SPOTIFY_CLIENT_SECRET=your-spotify-client-secret-here

# YouTube Cookies File (optional — needed if YouTube blocks requests)
# See README for instructions on how to export cookies
# COOKIES_FILE=cookies.txt
